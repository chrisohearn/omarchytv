#!/bin/sh
ROOT=${OMARCHY_REMOTE_ROOT:-/var/lib/omarchytv-remote}
mkdir -p "$ROOT"
chmod 700 "$ROOT"
exec 8>"$ROOT/service.lock"
flock -n 8 || exit 0
child=
stopping=
stop() {
  # A signal can arrive between starting a child and assigning its PID.
  case "$child" in
    starting) stopping=1; return 0 ;;
    '') exit 0 ;;
  esac
  trap '' TERM INT HUP
  kill "$child" 2>/dev/null
  wait "$child" 2>/dev/null
  exit 0
}
wait_for_child() {
  [ -z "$stopping" ] || stop
  wait "$child"
  child=
}
trap stop TERM INT HUP
echo $$ > "$ROOT/supervisor.pid"
retry_delay=3
while :; do
  [ "$(wc -c < "$ROOT/service.log" 2>/dev/null || echo 0)" -lt 65536 ] || mv "$ROOT/service.log" "$ROOT/service.log.old"
  started=$(date +%s)
  child=starting
  /usr/bin/node "$ROOT/app/server.js" >>"$ROOT/service.log" 2>&1 &
  child=$!
  echo "$child" > "$ROOT/service.pid"
  wait_for_child
  elapsed=$(( $(date +%s) - started ))
  [ "$elapsed" -lt 60 ] || retry_delay=3
  child=starting
  sleep "$retry_delay" &
  child=$!
  wait_for_child
  retry_delay=$((retry_delay * 2))
  [ "$retry_delay" -le 30 ] || retry_delay=30
done
